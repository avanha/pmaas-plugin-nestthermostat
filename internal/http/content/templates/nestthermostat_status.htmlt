<div class="entity-nestthermostat-status">
    <div class="container">
        <div class="group-label">Google Account</div>
        <div class="container nowrap">
            <div class="label">User</div>
            <div class="value user-value">
                {{if eq .GoogleUser ""}}
                    Not Logged In
                {{else}}
                    {{if ne .GoogleUserPicture ""}}
                        <img class="profile-pic" src="{{.GoogleUserPicture}}" referrerpolicy="no-referrer" alt="">
                    {{end}}
                    {{.GoogleUser}}
                {{end}}
            </div>
        </div>
        <div class="container nowrap token-summary">
            <div class="label">Refresh Token</div>
            <div class="value">
                {{if eq .RefreshTokenState "none"}}
                    <i class="bi bi-x-circle-fill token-missing"></i> Not Configured
                {{else if eq .RefreshTokenState "rejected"}}
                    <i class="bi bi-x-circle-fill token-missing"></i> Rejected by Google
                {{else if eq .RefreshTokenState "expired"}}
                    <i class="bi bi-x-circle-fill token-missing"></i> Expired
                {{else if eq .RefreshTokenState "expiring"}}
                    <i class="bi bi-exclamation-triangle-fill token-warning"></i> Expiring Soon
                {{else}}
                    <i class="bi bi-check-circle-fill token-ok"></i> Configured
                {{end}}
            </div>
            <div>
                <button class="get-token-button{{if or (eq .RefreshTokenState "none") (eq .RefreshTokenState "rejected") (eq .RefreshTokenState "expired")}} attention{{end}}">Get Token</button>
            </div>
        </div>
        {{if .HasRefreshToken}}
            <div class="container token-details">
                <div class="detail">
                    <span class="label">Obtained</span>
                    <span class="timestamp">{{.RefreshTokenObtainedTime.Format "2006-01-02 3:04:05 PM"}}</span>
                </div>
                <div class="detail">
                    <span class="label">Expires</span>
                    <span class="timestamp expiration {{.RefreshTokenState}}">
                        {{if .RefreshTokenNoExpiry}}
                            None reported{{if .RefreshTokenEstimateDisproven}}
                            <span class="note">(the estimate passed and the token still works)</span>{{end}}
                        {{else}}
                            {{.RefreshTokenExpiration.Format "2006-01-02 3:04:05 PM"}}
                            <span class="remaining">({{FormatRemaining .RefreshTokenExpiration}})</span>
                            {{if not .RefreshTokenExpirationKnown}}<span class="note estimated">(Estimated)</span>{{end}}
                        {{end}}
                    </span>
                </div>
            </div>
        {{end}}
        {{if or (eq .RefreshTokenState "rejected") (eq .RefreshTokenState "expired")}}
            <div class="container token-notice">
                <div class="wrap value token-missing reauthorize-message">
                    {{if or (eq .RefreshTokenState "rejected") .RefreshTokenExpirationKnown}}
                        The plugin can't reach Google until it's authorized again. Use Get Token.
                    {{else}}
                        The estimated expiration has passed. If the plugin has stopped receiving data, use Get Token.
                    {{end}}
                </div>
            </div>
        {{end}}
    </div>
    <div class="container">
        <div class="group-label">Activity</div>
        <div class="container nowrap">
            <div class="label">Last Poll</div>
            <div class="timestamp">
                {{if .LastPollTime.IsZero}}Never{{else}}{{.LastPollTime.Format "2006-01-02 3:04:05 PM"}}{{end}}
            </div>
        </div>
        <div class="container nowrap">
            <div class="label">Last Pub/Sub Message</div>
            <div class="timestamp">
                {{if .LastPubSubMessageTime.IsZero}}
                    Never
                {{else}}
                    {{.LastPubSubMessageTime.Format "2006-01-02 3:04:05 PM"}}
                {{end}}
            </div>
        </div>
    </div>
    <div class="container">
        <div class="group-label">Last Error</div>
        <div class="container nowrap">
            <div class="label">Time</div>
            <div class="timestamp">
                {{if .LastErrorTime.IsZero}}Never{{else}}{{.LastErrorTime.Format "2006-01-02 3:04:05 PM"}}{{end}}
            </div>
        </div>
        {{if not .LastErrorTime.IsZero}}
            <div class="container nowrap">
                <div class="wrap value monospace">{{.LastErrorMessage}}</div>
            </div>
        {{end}}
    </div>
</div>
